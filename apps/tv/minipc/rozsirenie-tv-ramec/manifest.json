{
  "manifest_version": 3,
  "name": "AdNa – TV prehrávač v obrazovke čakárne",
  "version": "1.2",
  "description": "Iba pre kioskový profil obrazovky AdNa: dovolí zobraziť a prihlásiť webový prehrávač Antik TV vo vyhradenej zóne stránky /obrazovka/.",
  "permissions": [
    "declarativeNetRequest",
    "webRequest",
    "cookies",
    "privacy",
    "contentSettings",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "pozadie.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ramec",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "cela-zona.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
